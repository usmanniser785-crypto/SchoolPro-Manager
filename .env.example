# ----------------------------------------------------
# SchoolPro Manager - Environment Configuration (.env)
# ----------------------------------------------------

# SUPABASE CLIENT CONFIGURATION (Safe for Client App)
# Replace with your Supabase Project URL and Anon/Public Key from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# GOOGLE OAUTH CONFIGURATION
# Google Cloud Console Web/Android OAuth Client ID configured in Supabase Auth -> Providers -> Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OPTIONAL GEMINI AI API KEY (Configured via AI Studio Secrets panel)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
